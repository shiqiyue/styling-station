# ---- 不进构建上下文（镜像不需要 / 含敏感数据）----
.git
.gitignore
.gitattributes
docker-compose.yaml
.dockerignore
*.bat
*.zip
*.log
README.md
docs
backups
dist
node_modules

# 服务端：数据目录含 settings.json（arkApiKey），绝不入镜像
server/data
server/test
server/_smoke.mjs

# Flutter：保留构建所需（lib / web / assets / android 源码 / pubspec 等）；
# docker/ 目录要保留 —— Dockerfile.web 会从中拷贝 nginx.conf；
# 排除构建缓存与本机私有文件
app/.env
app/.dart_tool
app/build
app/test
app/.idea
app/android/build
app/android/app/build
app/android/.gradle
app/android/.idea
app/android/local.properties
app/android/key.properties
